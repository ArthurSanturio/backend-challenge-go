# O Go não carrega este arquivo automaticamente.
# O Docker Compose usa estes valores ao copiar este arquivo para .env.
HTTP_PORT=8080
POSTGRES_HOST_PORT=5432
POSTGRES_DB=backend_challenge
POSTGRES_USER=challenge
POSTGRES_PASSWORD=local_development_only

# Endereço para executar a aplicação diretamente na máquina.
# Dentro de um container, o host do banco será postgres.
DATABASE_URL=postgres://challenge:local_development_only@localhost:5432/backend_challenge?sslmode=disable

# Os testes criam e removem bancos temporários. O usuário precisa de CREATEDB.
# Exporte esta variável no terminal para executar os testes com tag integration.
POSTGRES_TEST_URL=postgres://challenge:local_development_only@localhost:5432/backend_challenge?sslmode=disable

# O Keycloak importa automaticamente o realm e os clientes de desenvolvimento.
KEYCLOAK_HOST_PORT=8081
OIDC_ISSUER_URL=http://localhost:8081/realms/wallet
OIDC_JWKS_URL=http://localhost:8081/realms/wallet/protocol/openid-connect/certs
OIDC_AUDIENCE=wallet-api
# No Compose, o endereço JWKS usa o hostname interno keycloak.
# As credenciais locais dos clientes estão em deploy/keycloak/wallet-realm.json.

# Consumidor SQS. O setup gera credenciais IAM restritas por serviço.
SQS_ENABLED=true
AWS_REGION=us-east-1
AWS_SHARED_CREDENTIALS_FILE=.local/sqs-runtime-credentials
AWS_EC2_METADATA_DISABLED=true
SQS_HOST_PORT=4566
SQS_ENDPOINT_URL=http://localhost:4566
# Em AWS, omita SQS_ENDPOINT_URL e utilize a role IAM do processo.

# Publicação da outbox e retomada de operações pendentes.
WORKERS_ENABLED=true
OUTBOX_MAX_ATTEMPTS=8
REFERENCE_MAX_ATTEMPTS=100
REFERENCE_TTL=24h
